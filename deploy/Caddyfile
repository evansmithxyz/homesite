# evansmith.xyz: the homepage, with each project in its own folder.
# scripts/deploy.sh installs this as /etc/caddy/Caddyfile.
#
#   /              homepage               /srv/homesite
#   /diagrammer/   Sentence Diagrammer    /srv/sentence-grapher
#   /cube/         Cube Timer             /srv/cube
#   /api/          the diagrammer's spaCy parse server (set up by ../grammar/scripts/deploy.sh)

evansmith.xyz {
	encode zstd gzip

	# every request, one JSON line each; rolled at 10 MiB, old files gzipped, gone after 90 days.
	# scripts/logs.sh shows it as one readable line per request.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 20
			roll_keep_for 2160h
		}
	}

	# the parse server sees /parse and /health, without the /api prefix
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	# the apps load ./assets/..., which only resolves inside the folder with the trailing slash
	redir /diagrammer /diagrammer/ permanent
	handle_path /diagrammer/* {
		root * /srv/sentence-grapher
		file_server
	}

	redir /cube /cube/ permanent
	handle_path /cube/* {
		root * /srv/cube
		file_server
	}

	handle {
		root * /srv/homesite
		file_server
	}

	# file names under assets/ change with every build, so they can be cached for good
	@hashed path /diagrammer/assets/* /cube/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}

www.evansmith.xyz {
	redir https://evansmith.xyz{uri} permanent
}
